{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/g1mn/pqproof/blob/main/schemas/receipt-v3.schema.json",
  "title": "PQ-Proof receipt.json, evidence format 3",
  "description": "Shape of receipt.json written by pqproof 0.2.0 and later (format_version 3). Format 3 adds skip_dirs, the copy of scan/skip-dirs that the tree hash and the scanners used, and counts lines allowed by the name rule alone under r-allow. Generated from pqlite/receipt.py SCHEMA by tests/make_schemas.py. Fields named in guide/outputs.md as stable keep their meaning within a format_version. Text fields (checks[].title, expected, actual, note, warnings) are for people and can change in any release. pqproof --verify checks more than this schema: the receipt_id, every file hash and the consistency of the numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowlist",
    "artifacts",
    "cbom",
    "changed",
    "checks",
    "deck_meta",
    "excluded",
    "extra",
    "finished_at",
    "format",
    "format_version",
    "inputs",
    "java",
    "note",
    "params",
    "receipt_id",
    "ruleset_sha256",
    "ruleset_version",
    "skip_dirs",
    "started_at",
    "test_paths",
    "timeline",
    "tls",
    "tool_version",
    "tools",
    "verdict",
    "weakening"
  ],
  "properties": {
    "format": {
      "const": "pqc-proof receipt 1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "note": {
      "const": "검증 증적: receipt_id는 receipt_id 칸을 뺀 이 JSON의 RFC 8785 정규형(키 정렬, 공백 없음, UTF-8) SHA-256이고, artifacts·tables의 모든 파일과 evidence-fragment.json이 SHA-256과 함께 적혀 있다. `pqproof --verify DIR`(또는 `bash prove.sh --verify DIR`)이 다시 계산한다. 해시는 파일이 이 증적이 말하는 그 파일임을 보일 뿐, 누가 만들었는지는 보이지 않는다. receipt_id를 믿을 수 있는 곳에서 받은 값과 비교할 것."
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "undecided"
      ]
    },
    "format_version": {
      "const": 3
    },
    "tool_version": {
      "type": "string",
      "pattern": "^[0-9][0-9A-Za-z.+-]*$"
    },
    "ruleset_version": {
