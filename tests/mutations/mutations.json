{
 "format": "pqproof mutations 1",
 "about": "Planted defects built from examples/classic and examples/pqc. Each one states the result PQ-Proof must give. run_mutations.py applies them in a temp folder, runs the tool, and compares. A mutation whose setup cannot be applied is SKIP, and SKIP is never counted as PASS.",
 "about_ko": "examples/classic·pqc 에서 만든 심어 둔 결함. 각 항목에 PQ-Proof가 반드시 내야 할 결과를 적었다. run_mutations.py 가 임시 폴더에 적용하고 도구를 돌려 비교한다. 준비를 못 한 항목은 SKIP 이고 SKIP 은 PASS 로 세지 않는다.",
 "mutations": [
  {
   "id": "c01-examples-classic-to-pqc",
   "title": "control: examples/classic against examples/pqc (the migration done right)",
   "title_ko": "대조군: examples/classic → examples/pqc(제대로 된 전환)",
   "kind": "tree",
   "orig": "classic",
   "base": "pqc",
   "edits": [],
   "control": true,
   "expect": {
    "exit": 0,
    "verdict": "pass",
    "checks": {
     "a-cbom": "pass",
     "c-classic": "pass",
     "c-expect": "pass",
     "b-weakening": "pass",
     "r-review": "pass"
    },
    "stdout_regex_not": [
     "(?m)^VERDICT=PASS \\("
    ]
   },
   "sarif": {
    "max_results": 0
   }
  },
  {
   "id": "c02-examples-classic-to-classic",
   "title": "control: examples/classic on both sides (nothing migrated)",
   "title_ko": "대조군: 양쪽 모두 examples/classic(전환 안 함)",
   "kind": "tree",
   "orig": "classic",
   "base": "classic",
   "edits": [],
   "control": true,
   "expect": {
    "exit": 1,
