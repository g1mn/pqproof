# jsonschema for the SARIF and evidence schema tests in CI only (tests/test_pqproof_pkg.py, tests/test_schemas.py).
# PQ-Proof does not depend on it at run time. Regenerate schema.txt (hashes for every file of each pin, all CI Pythons):
#   uv pip compile --universal --generate-hashes --python-version 3.9 --exclude-newer <two weeks ago> --no-header -o .github/requirements/schema.txt .github/requirements/schema.in
# jsonschema 4.26 needs Python 3.10 or newer, and CI still tests 3.9.
# Dependabot version updates skip this pair (dependabot.yml exclude-paths): its pip updater cannot regenerate a --universal lock.
# A Dependabot security update can still touch schema.txt; regenerate it with the command above instead of merging that diff.
jsonschema==4.25.1 ; python_version < '3.10'
jsonschema==4.26.0 ; python_version >= '3.10'
